            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "properties": {
              "sector": {
                "type": "string",
                "description": "Sector name, e.g. \"grid-scale storage\""
              },
              "year": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "Calendar year to report on"
              }
            },
            "required": [
              "sector",
              "year"
            ],
            "additionalProperties": false
          },
          "taints": true
        }
      ],
      "mcp_servers": [],
      "models": [
        "qwen2.5:7b"
      ]
    }
  },
