{
  "manifest": {
    "name": "market-analysis-block",
    "version": "1.2.0",
    "description": "Analyzes a market sector against recent data and returns a written analysis.",
    "source": "@acme/market-analysis-block",
    "inputs": {
      "sector": {
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
