{
  "name": "@cycgraph/studio",
  "version": "0.2.0",
  "description": "The cycgraph studio: debug, improve, and monitor cycgraph runs — dashboard, counterfactual forking, and the tune/improve ladder over your own graphs.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wmcmahan/cycgraph.git",
    "directory": "packages/studio"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/main.d.ts",
      "import": "./dist/cli/main.js",
      "default": "./dist/cli/main.js"
    }
  },
  "scripts": {
    "studio": "tsx src/bin.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit && tsc -p ui/tsconfig.json",
    "build": "tsc -p tsconfig.build.json && npm run build:ui && rm -rf dist/server/app && cp -R ui/out dist/server/app",
    "prepack": "npm run build",
    "build:ui": "next build ui"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.36",
    "@cycgraph/a2a": "^1.0.0",
    "@cycgraph/evals": "^0.3.1",
    "@cycgraph/memory": "^0.8.0",
    "@cycgraph/orchestrator": "^1.2.3",
    "@cycgraph/orchestrator-postgres": "^4.1.2",
    "@cycgraph/tools": "^1.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.0",
    "zod": "^4.3.6",
    "tsx": "^4.19.2",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/exporter-prometheus": "^0.219.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "typescript": "7.0.2",
    "vitest": "^4.0.18",
    "next": "^16.2.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^3.6.0",
    "lucide-react": "^0.469.0",
    "radix-ui": "^1.6.7",
    "class-variance-authority": "^0.7.1",
    "tw-animate-css": "^1.4.0",
    "shadcn": "^4.19.0"
  },
  "bin": {
    "cycgraph-studio": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ]
}